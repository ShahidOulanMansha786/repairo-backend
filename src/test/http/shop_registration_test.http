### Expected: 200 with approvalStatus = "INCOMPLETE"
### (INCOMPLETE because documents not uploaded yet)
### ─────────────────────────────────────────
GET http://localhost:8080/shops/my-status
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJrZWxseWFsb2szNDBAZ21haWwuY29tIiwicm9sZSI6IlNIT1BfT1dORVIiLCJpYXQiOjE3Nzk0MzEzMTAsImV4cCI6MTc3OTUxNzcxMH0.BJdVTLQ7OB38n-gtrWp033dzTGJxCl2G8bStxHTJ9eY

> {%
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
